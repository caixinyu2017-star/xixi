# 把这个文件复制成 .env，填上你的 Key 就能用真实的 Claude 作答。
# 不填也能跑：会自动进入离线演示模式，用内置的嘉兴案例脚本作答，录屏演示照样完整。

ANTHROPIC_API_KEY=sk-ant-在这里填你的key

# 如果你用的是中转/代理服务，把它的地址填在这里；官方直连请留空或删掉这一行
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 可选：模型与参数
HCX_MODEL=claude-sonnet-4-5-20250929
HCX_MAX_TOKENS=8000

# 可选：强制离线演示模式（录屏时想保证万无一失就设成 1）
# HCX_DEMO=1

# 可选：服务地址
HCX_HOST=127.0.0.1
HCX_PORT=8848
