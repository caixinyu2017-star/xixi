# 把这个文件复制成 .env（启动脚本会自动帮你复制一份）。
#
# 不填任何东西也能跑：禾创星会自动进入离线演示模式，
# 用内置的嘉兴案例脚本作答，两份 Word 照常生成，断网也不影响。
#
# 想接真实的 Claude 实时生成，就把下面这行前面的井号去掉，填上你的 Key：
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 如果你用的是中转或代理服务，把它的地址填在这里（官方直连不用管这行）
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 可选：模型与生成长度
HCX_MODEL=claude-sonnet-4-5-20250929
HCX_MAX_TOKENS=8000

# 可选：强制离线演示模式。录屏时想万无一失，就把下面这行的井号去掉。
# HCX_DEMO=1

# 可选：服务地址与端口。端口被占用时改这里。
HCX_HOST=127.0.0.1
HCX_PORT=8848
