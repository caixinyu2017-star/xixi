# ============================================================
#  把这个文件复制成 .env，填上真实值。.env 已经在 .gitignore 里，不会被提交。
#  绝对不要把账号密码写进 config.yaml —— 那个文件是会被分享/提交的。
# ============================================================

# ---- WebVPN / 统一身份认证 ----
WEBVPN_USERNAME=你的工号
WEBVPN_PASSWORD=你的统一身份认证密码

# ---- 邮件告警（推荐：QQ 邮箱）----
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成「授权码」
# 这里填的是【授权码】，不是你的 QQ 密码
SMTP_USERNAME=你的邮箱@qq.com
SMTP_PASSWORD=十六位授权码

# ---- 手机即时推送（任选其一或多个）----
# Bark（iOS，App Store 搜 Bark，装完 App 里直接能看到 key）
# BARK_KEY=

# Server酱（微信收消息，https://sct.ftqq.com 扫码即得）
# SERVERCHAN_SENDKEY=

# 企业微信群机器人（群设置 → 群机器人 → 添加，复制 webhook 里的 key= 后面那段）
# WECOM_KEY=

# 钉钉自定义机器人
# DINGTALK_TOKEN=
# DINGTALK_SECRET=

# 飞书自定义机器人
# FEISHU_TOKEN=
# FEISHU_SECRET=

# PushPlus（微信推送，https://www.pushplus.plus）
# PUSHPLUS_TOKEN=

# ---- IP 定位增强（可选）----
# 腾讯位置服务 key（https://lbs.qq.com 申请，个人免费 1 万次/天）
# 目前唯一「国内基本都能定位到区/县」的在线 API
# QQMAP_KEY=
